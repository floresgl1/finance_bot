# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Alpaca (paper trading) --- live_trader, rebalancer, reconcile_stops, smoke_alpaca
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_key_here

# --- News headlines --- headlines_data_collector
FINNHUB_API_KEY=your_key_here

# --- LLM agents (pre-trade, daily, post-trade) --- agent_runner, agent_tools, agent_posttrade
GROQ_API_KEY=your_key_here
TAVILY_API_KEY=your_key_here

# --- Sharadar (sharadar.com key, api.sharadar.com) --- sharadar_download, sharadar_sample
SHARADAR_API_KEY=your_key_here

# --- Alerts --- every script that posts to Discord
DISCORD_WEBHOOK_URL=your_webhook_url_here

# --- GitHub --- fine-grained tokens scoped to this repo, Actions: read and write.
# They expire: set a calendar reminder, or the scheduled runs stop.
# dispatch_workflow.py (12:00 / 14:15 UTC PA tasks)
GITHUB_DISPATCH_TOKEN=your_token_here
# edge_monitor.py auto-retrain trigger
GITHUB_PAT=your_token_here

# --- PythonAnywhere API --- create_pa_*_tasks.py, pipeline_status.py, upload_to_pythonanywhere.py
PYTHONANYWHERE_TOKEN=your_token_here
PYTHONANYWHERE_USERNAME=your_username_here
